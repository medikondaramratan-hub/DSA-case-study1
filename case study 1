class Node {
    int key, height;
    Node left, right;

    Node(int d) {
        key = d;
        height = 1;
    }
}

public class NetflixAVL {

    Node root;

    int height(Node N) {
        if (N == null)
            return 0;
        return N.height;
    }

    int max(int a, int b) {
        return (a > b) ? a : b;
    }

    Node rightRotate(Node y) {
        Node x = y.left;
        Node T2 = x.right;

        x.right = y;
        y.left = T2;

        y.height = max(height(y.left), height(y.right)) + 1;
        x.height = max(height(x.left), height(x.right)) + 1;

        return x;
    }

    Node leftRotate(Node x) {
        Node y = x.right;
        Node T2 = y.left;

        y.left = x;
        x.right = T2;

        x.height = max(height(x.left), height(x.right)) + 1;
        y.height = max(height(y.left), height(y.right)) + 1;

        return y;
    }

    int getBalance(Node N) {
        if (N == null)
            return 0;
        return height(N.left) - height(N.right);
    }

    Node insert(Node node, int key) {

        if (node == null)
            return (new Node(key));

        if (key < node.key)
            node.left = insert(node.left, key);
        else if (key > node.key)
            node.right = insert(node.right, key);
        else
            return node;

        node.height = 1 + max(height(node.left), height(node.right));

        int balance = getBalance(node);

        // LL Rotation
        if (balance > 1 && key < node.left.key)
            return rightRotate(node);

        // RR Rotation
        if (balance < -1 && key > node.right.key)
            return leftRotate(node);

        // LR Rotation
        if (balance > 1 && key > node.left.key) {
            node.left = leftRotate(node.left);
            return rightRotate(node);
        }

        // RL Rotation
        if (balance < -1 && key < node.right.key) {
            node.right = rightRotate(node.right);
            return leftRotate(node);
        }

        return node;
    }

    void inorder(Node node) {
        if (node != null) {
            inorder(node.left);
            System.out.print(node.key + " ");
            inorder(node.right);
        }
    }

    boolean search(Node root, int key) {
        if (root == null)
            return false;

        if (root.key == key)
            return true;

        if (key < root.key)
            return search(root.left, key);

        return search(root.right, key);
    }

    void topKRecent(Node node, int[] count) {
        if (node == null || count[0] >= 5)
            return;

        topKRecent(node.right, count);

        if (count[0] < 5) {
            System.out.print(node.key + " ");
            count[0]++;
        }

        topKRecent(node.left, count);
    }

    public static void main(String[] args) {

        NetflixAVL tree = new NetflixAVL();

        int timestamps[] = {
                1200, 2400, 3600, 4800, 6000,
                7200, 8400, 9600, 10800
        };

        for (int t : timestamps)
            tree.root = tree.insert(tree.root, t);

        System.out.println("=================================");
        System.out.println(" Netflix Watch History System");
        System.out.println("=================================");

        System.out.println("\nWatch History Records:");
        tree.inorder(tree.root);

        System.out.println("\n\nSearch Timestamp: 7200");
        if (tree.search(tree.root, 7200))
            System.out.println("Record Found");
        else
            System.out.println("Record Not Found");

        System.out.println("\nSearch Timestamp: 15000");
        if (tree.search(tree.root, 15000))
            System.out.println("Record Found");
        else
            System.out.println("Record Not Found");

        System.out.println("\nTOP 5 RECENT SHOWS");
        int count[] = {0};
        tree.topKRecent(tree.root, count);

        System.out.println("\n\nTime Complexity:");
        System.out.println("Insert : O(log n)");
        System.out.println("Search : O(log n)");

        System.out.println("\nAVL Tree efficiently maintains");
        System.out.println("Netflix watch history records.");
    }
}
